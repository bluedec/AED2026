// Dada una secuencia texto de entrada que contiene palabras alfanuméricas,
// escribir un algoritmo que genere dos secuencias de salida.
// 
// Una de ellas contendrá solo las palabras de la secuencia original que comienzan con vocal,
// en las cuales se reemplazarán todas las vocales por ‘#’.
// 
// Por ejemplo: entrada 'avión1', salida '#v##n1'. 
// 
// La otra será una secuencia numérica en la que se almacenarán las cantidades de vocales 
// que se encontraron en cada una de las palabras que cumplieron la condición.
// 
// Por final de proceso se deberá informar el promedio de palabras por oración.

ACCION palabras_con_vocales ES
AMBIENTE
  sec, sal1: secuencia de caracter
  sal2: secuencia de entero
  c: caracter
  cont_ora: entero
  cont_pal: entero
  cont_voc: entero
  vocales:= ['a', 'e', 'i', 'o', 'u']
PROCESO
  ARR(sec)
  CREAR(sal1)
  CREAR(sal2)
  AVZ(sec, c)
  cont_ora := 0;
  cont_pal := 0;
  cont_voc := 0;

  MIENTRAS NFDS(sec) HACER
    MIENTRAS c <> '.' y NFDS(sec) HACER
      MIENTRAS c = ' ' HACER
        AVZ(sec, c)
      FIN_MIENTRAS

      cont_voc := 0
      SI c en vocales HACER
        cont_voc := cont_voc + 1
        ESC(sal1, '#')
        AVZ(sec, c)
        MIENTRAS c <> ' ' y c <> '.' y NFDS(sec) HACER
          SI c en vocales HACER
            ESC(sal1, '#')
            cont_voc := cont_voc + 1
          SINO
            ESC(sal1, c)
          FIN_SI
          ESC(sal1, ' ')
          AVZ(sec, c)
        FIN_MIENTRAS
        cont_pal := cont_pal + 1
        ESC(sal2, cont_voc)
      SINO 
        MIENTRAS NFDS(sec) y c <> '.' y c <> ' ' HACER
          AVZ(sec, c)
        FIN_MIENTRAS
        cont_pal := cont_pal + 1
      FIN_SI
    FIN_MIENTRAS
    cont_ora := cont_ora + 1
    AVZ(sec, c)
  FIN_MIENTRAS
  ESC("En promedio hubo ", cont_pal/cont_ora, " palabras por oracion");
FIN_ACCION






