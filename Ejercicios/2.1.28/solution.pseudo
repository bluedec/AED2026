// La galería de pintura y arte nacional, PINTA DE ARGENTINA, almacena información sobre los artistas y sus obras de arte en secuencias de caracteres.
// 
// Durante todo el año, las obras de arte son expuestas en eventos de subasta y exposición, en los cuales se comercializan al público en general.
// A fin de año la Comisión Directiva de la Galería solicita que, a partir de toda esa información, se generen algunos informes.
// 
// Se debe tener en cuenta lo siguiente:
// 
// - En la secuencia ARTISTAS, se almacena el estilo de arte ('R' – Renacentista, 'M' – Arte Moderno, 'B' – Barroco, 'S' – Surrealismo),
// el nombre de cada artista, lugar de nacimiento, edad y cantidad de obras por artista.
// 
// - Los datos de cada artista están separados entre sí por el símbolo '+' y finalizan con el símbolo '?'.
// 
// - En la secuencia OBRAS, se almacena el nombre de la obra, el año en que fue hecha, su precio, precedido siempre del signo
// '$' (solo 3 digitos) y su estado ('V' – Vendido, 'R' – Reservado, 'U' – Obra Única).
// 
// - Todos los datos de las obras están separados por el símbolo ',' y finalizan con el símbolo '/'.
// 
// - El creador de cada obra se determina de acuerdo al dato 'cantidad de obras' de la secuencia ARTISTAS,
// por ej.: el autor RENE BARTOL tiene 2 obras, por lo cual las primeras 2 obras de la secuencia OBRAS le pertenecen, las siguientes 6,
// pertenecen a JUAN B JUSTO, etc.
// A continuación un ejemplo de ambas secuencias:
// 
// SECUENCIA ARTISTAS
// 
// M+RENE BARTOL+ROSARIO+34+2?R+JUAN B JUSTO+NEUQUEN+61+5?…………
// 
// SECUENCIAS OBRAS
// SOL Y PARANA,1997,$913,V/GRITO DE ESPERANZA,2003,$235,R/PENAS,1997,$781,V/………
// 
// A partir de lo expuesto anteriormente, se pide:
// 
// Generar una secuencia de salida con información de los artistas Renacentistas. La secuencia debe contener el nombre del artista
// seguido de sus obras (nombre y año de creación).
// Los datos correspondientes al mismo artista deben separarse entre sí con el signo '+' y finalizar con el signo '?'.
// Al final del proceso informar:
// La mayor cantidad de obras vendidas por un artista.
// El porcentaje de obras de artistas "renacentistas" sobre el total de obras.

ACCION artistas ES
AMBIENTE
  artistas: secuencia de caracter // M+Jose+CHACO+26+cantidad_de_obras?
  v1: caracter
  obras: secuencia de caracter  // Nombre,2026,$pre,estado/
  v2: caracter
  artistas_renac: secuencia de caracter // nombre+obra_1+obra_2+mona lisa, 1998+obra_n?
  cant_obras: entero
  mayor_vendedor: entero // mayor cantidad de vendidos
  tot_obras: entero // obras
  tot_obras_renac: entero // cobras renacentistas
  porcentaje: real(2, 2)
  es_renacentista: logico
  i: entero
  vendidas: entero

  funcion char_a_num(char: caracter): entero
    ambiente
      x: entero
    proceso
      SEGUN char:
        ='0' : x := 0
        ='1' : x := 1
        ...
      FIN_SEGUN
      char_a_num := x
    fin_funcion

    procedimiento avz_campo_art() es
      MIENTRAS v1 <> '+' HACER
        AVZ(artistas, v1)
      FIN_MIENTRAS
    fin_procedimiento
PROCESO
  ARR(artistas)
  AVZ(artistas, v1)
  ARR(obras)
  AVZ(obras, v2)
  CREAR(artistas_renac)
  mayor_vendedor := 0
  tot_obras := 0
  tot_obras_renac := 0
  porcentaje := 0.00
  
  MIENTRAS NFDS(artistas) y NFDS(obras) HACER
    es_renacentista := F
    cant_obras := 0
    vendidas := 0
    SI v1 = 'R' HACER
      es_renacentista := V
    FIN_SI
    AVZ(artistas, v1)
    AVZ(artistas, v1)
    MIENTRAS NFDS(artistas) y v1 <> '+' HACER
      SI es_renacentista HACER
        ESC(artistas_renac, v1)
      FIN_SI
      AVZ(artistas, v1)
    FIN_MIENTRAS
    avz_campo_art()
    avz_campo_art()
    AVZ(artistas, v1)
    MIENTRAS NFDS(artistas) y v1 <> '?' HACER
      cant_obras := (cant_obras * 10) + char_a_num(v1)
      AVZ(artistas, v1)
    FIN_MIENTRAS
    tot_obras := tot_obras + cant_obras
    SI es_renacentista HACER
      tot_obras_renac := tot_obras_renac + cant_obras
      ESC(artistas_renac, '+')
    FIN_SI
    AVZ(artistas, v1)

    PARA i := 1 HASTA cant_obras; HACER 
      MIENTRAS NFDS(obras) y v2 <> ',' HACER
        SI es_renacentista HACER
          ESC(artistas_renac, v2)
        FIN_SI
        AVZ(obras, v2)
      FIN_MIENTRAS
      SI es_renacentista HACER
        ESC(artistas_renac, ',')
      FIN_SI
      AVZ(obras, v2)
      MIENTRAS NFDS(obras) y v2 <> ',' HACER
        SI es_renacentista HACER
          ESC(artistas_renac, v2)
        FIN_SI
        AVZ(obras, v2)
      FIN_MIENTRAS
      AVZ(obras, v2)
      // Salteamos Precio
      MIENTRAS NFDS(obras) y v2 <> ',' HACER
        AVZ(obras, v2)
      FIN_MIENTRAS
      AVZ(obras, v2)
      SI v2 = 'V' HACER
        vendidos := vendidos + 1
      FIN_SI
      AVZ(obras, v2)
      AVZ(obras, v2)
      SI es_renacentista HACER
        SI i < cant_obras HACER
          ESC(artistas_renac, '+')
        SINO 
          ESC(artistas_renac, '?')
        FIN_SI
      FIN_SI
    FIN_PARA

    SI vendidos > mayor_vendedor HACER
      mayor_vendedor := vendidos
    FIN_SI
  FIN_MIENTRAS

  SI tot_obras > 0 HACER
    porcentaje := (tot_obras_renac / tot_obras) * 100
    ESC("El porcentaje de obras renacentistas fue del ", porcentaje, "%")
  SINO
    ESC("No se encontraron obras")
  FIN_SI
  
  ESC("La mayor cantidad de ventas por un solo artista fue de: ", mayor_vendedor)
FIN_ACCION
